# Optional overrides. PaperTrail reads process environment variables; it does not load this file.
PAPERTRAIL_MODEL=qwen3.5:4b
PAPERTRAIL_OLLAMA_URL=http://127.0.0.1:11434
PAPERTRAIL_DATA_DIR=.papertrail
PAPERTRAIL_MODEL_TIMEOUT=240
# Hard deadline for each browser operation, including source retrieval and evidence review.
PAPERTRAIL_OPERATION_TIMEOUT=240
