{
  "name": "papertrail-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-sample.mjs && vite --host 127.0.0.1 --port 5173",
    "build": "node scripts/prepare-sample.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node --test tests/*.test.js",
    "check": "prettier --check src tests scripts index.html vite.config.js"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
