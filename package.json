{
  "name": "papertrail",
  "version": "1.0.0",
  "private": true,
  "description": "Reviewer-grade analysis of research papers, computed entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Gagan P",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "models": "node scripts/fetch-models.mjs",
    "eval": "node scripts/eval.mts",
    "postinstall": "node scripts/copy-ort.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@huggingface/transformers": "4.3.1",
    "clsx": "2.1.1",
    "d3-force": "3.0.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "umap-js": "1.4.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-force": "3.0.10",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
